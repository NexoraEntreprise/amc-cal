{% extends 'base.html.twig' %}

{% block title %}Inscription - Amicale{% endblock %}

{% block body %}
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
        background-color: #1a1a1a;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 20px;
    }

    .auth-container {
        background-color: #f8fafd;
        width: 100%;
        max-width: 430px;
        border-radius: 30px;
        padding: 35px 24px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    }

    .auth-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .auth-icon-wrapper {
        background-color: #eff4fc;
        width: 65px;
        height: 65px;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0 auto 15px auto;
    }

    .auth-icon-wrapper i {
        font-size: 28px;
        color: #0b2240;
    }

    .auth-header h1 {
        color: #0b2240;
        font-size: 24px;
        font-weight: 700;
        letter-spacing: 0.5px;
        margin-bottom: 6px;
    }

    .auth-header p {
        color: #7e8b9b;
        font-size: 13.5px;
    }

    .auth-form {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .auth-form div {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .auth-form label {
        color: #0b2240;
        font-size: 15px;
        font-weight: 600;
    }

    .auth-form input[type="email"],
    .auth-form input[type="password"],
    .auth-form input[type="text"] {
        width: 100%;
        height: 50px;
        padding: 0 16px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background-color: #ffffff;
        font-size: 14.5px;
        color: #333;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .auth-form input:focus {
        border-color: #3b5a85;
        box-shadow: 0 0 0 3px rgba(59, 90, 133, 0.12);
    }

    .auth-form input[type="checkbox"] {
        width: 18px;
        height: 18px;
        accent-color: #0b2240;
    }

    .auth-form .form-check,
    .auth-form div:has(input[type="checkbox"]) {
        flex-direction: row;
        align-items: center;
        gap: 10px;
    }

    .form-errors,
    .auth-form ul {
        list-style: none;
        background-color: #fee2e2;
        color: #991b1b;
        border-radius: 10px;
        padding: 12px;
        font-size: 14px;
        margin-bottom: 15px;
    }

    .btn-auth {
        background-color: #0b2240;
        color: #ffffff;
        border: none;
        border-radius: 10px;
        height: 54px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 10px;
        transition: background-color 0.2s;
        width: 100%;
    }

    .btn-auth:hover {
        background-color: #14355e;
    }

    .auth-link {
        text-align: center;
        margin-top: 18px;
        font-size: 14px;
        color: #7e8b9b;
    }

    .auth-link a {
        color: #0b2240;
        font-weight: 600;
        text-decoration: none;
    }
</style>

<div class="auth-container">
    <div class="auth-header">
        <div class="auth-icon-wrapper">
            <i class="fa-regular fa-user"></i>
        </div>

        <h1>INSCRIPTION</h1>
        <p>Créez votre compte pour accéder au formulaire</p>
    </div>

    <div class="form-errors">
        {{ form_errors(registrationForm) }}
    </div>

    {{ form_start(registrationForm, {'attr': {'class': 'auth-form'}}) }}

        {{ form_row(registrationForm.email, {
            label: 'Adresse email'
        }) }}

        {{ form_row(registrationForm.plainPassword, {
            label: 'Mot de passe'
        }) }}

        {{ form_row(registrationForm.agreeTerms, {
            label: 'J’accepte les conditions'
        }) }}

        <button type="submit" class="btn-auth">
            S’INSCRIRE
        </button>

    {{ form_end(registrationForm) }}

    <div class="auth-link">
        Déjà un compte ?
        <a href="{{ path('app_login') }}">Se connecter</a>
    </div>
</div>
{% endblock %}