{% extends 'base.html.twig' %}

{% block title %}Admin - Amicale
{% endblock %}

{% block body %}
	<div class="admin-page">

		<div class="admin-header">
			<h1>Tableau de bord</h1>

			<a href="{{ path('app_register') }}" class="btn-create-user">
				<i class="fa-solid fa-user-plus"></i>
				Créer un compte
			</a>
		</div>

		<div class="stats">
			<div class="card">
				<span>Calendriers vendus</span>
				<strong>{{ totalCalendriers|default(0) }}</strong>
			</div>

			<div class="card">
				<span>Argent récolté</span>
				<strong>{{ totalArgent|default(0)|number_format(2, ',', ' ') }}
					€</strong>
			</div>

			<div class="card">
				<span>Profils créés</span>
				<strong>{{ users|length }}</strong>
			</div>
		</div>

		<div class="section">
			<h2>Gestion</h2>

			<div class="admin-actions">
				<form method="post" action="{{ path('admin_create_tournee') }}" class="create-city-form">
					<input type="text" name="ville" placeholder="Nom de la ville" required>
					<input type="text" name="codePostal" placeholder="Code postal" required>

					<button type="submit" class="btn-action">
						<i class="fa-solid fa-plus"></i>
						Créer une ville
					</button>
				</form>

				<form method="post" action="{{ path('admin_reset_calendriers') }}" onsubmit="return confirm('ATTENTION : cela va supprimer tous les calendriers de toutes les villes et tous les utilisateurs. Confirmer ?');">
					<button type="submit" class="btn-danger">
						<i class="fa-solid fa-trash"></i>
						Reset tous les calendriers
					</button>
				</form>
			</div>
		</div>

		<div class="section">
			<h2>Profils</h2>

			<div class="profiles-grid">
				{% for user in users %}
					<div class="profile-card-wrapper">
						<a href="#user-{{ user.id }}" class="profile-card">
							<i class="fa-solid fa-user"></i>
							<span>{{ user.email }}</span>
						</a>

						<form method="post" action="{{ path('admin_delete_user', {id: user.id}) }}" onsubmit="return confirm('Supprimer ce profil ? Son historique calendrier sera aussi supprimé.');">
							<button type="submit" class="btn-delete-profile">
								<i class="fa-solid fa-trash"></i>
							</button>
						</form>
					</div>
				{% else %}
					<p>Aucun utilisateur créé.</p>
				{% endfor %}
			</div>
		</div>

		<div class="section">
			<h2>Liste des tournées par ville</h2>

			<table>
				<thead>
					<tr>
						<th>Nom de la ville</th>
						<th>Code postal</th>
						<th>Argent récolté</th>
						<th>Calendriers vendus</th>
					</tr>
				</thead>
				<tbody>
					{% for tournee in tournees %}
						<tr>
							<td data-label="Ville">{{ tournee.ville }}</td>
							<td data-label="Code postal">{{ tournee.codePostal }}</td>
							<td data-label="Argent récolté">{{ tournee.totalArgent|default(0)|number_format(2, ',', ' ') }}
								€</td>
							<td data-label="Calendriers vendus">{{ tournee.totalCalendriers|default(0) }}</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="4">Aucune tournée enregistrée.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>

		<div class="section">
			<h2>10 derniers calendriers donnés</h2>

			<table>
				<thead>
					<tr>
						<th>Nom</th>
						<th>Prénom</th>
						<th>Ville</th>
						<th>Code postal</th>
						<th>Montant</th>
						<th>Calendriers</th>
						<th>Ajouté par</th>
						<th>Date</th>
					</tr>
				</thead>
				<tbody>
					{% for calendrier in lastCalendriers %}
						<tr>
							<td data-label="Nom">{{ calendrier.nom }}</td>
							<td data-label="Prénom">{{ calendrier.prenom }}</td>
							<td data-label="Ville">{{ calendrier.tournee ? calendrier.tournee.ville : '-' }}</td>
							<td data-label="Code postal">{{ calendrier.tournee ? calendrier.tournee.codePostal : '-' }}</td>
							<td data-label="Montant">{{ calendrier.argentRecolte|number_format(2, ',', ' ') }}
								€</td>
							<td data-label="Calendriers">{{ calendrier.nombreCalendrier }}</td>
							<td data-label="Ajouté par">{{ calendrier.createdBy.email }}</td>
							<td data-label="Date">{{ calendrier.createdAt|date('d/m/Y H:i') }}</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="8">Aucun calendrier enregistré.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>

		<div class="section">
			<h2>Historique par profil</h2>

			{% for user in users %}
				<div class="user-card" id="user-{{ user.id }}">
					<h3>{{ user.email }}</h3>

					<table>
						<thead>
							<tr>
								<th>Nom</th>
								<th>Prénom</th>
								<th>Pompier</th>
								<th>Ville</th>
								<th>Code postal</th>
								<th>Montant</th>
								<th>Calendriers</th>
								<th>Date</th>
							</tr>
						</thead>
						<tbody>
							{% for calendrier in user.calendriers %}
								<tr>
									<td data-label="Nom">{{ calendrier.nom }}</td>
									<td data-label="Prénom">{{ calendrier.prenom }}</td>
									<td data-label="Pompier">{{ calendrier.prenomPompier }}</td>
									<td data-label="Ville">{{ calendrier.tournee ? calendrier.tournee.ville : '-' }}</td>
									<td data-label="Code postal">{{ calendrier.tournee ? calendrier.tournee.codePostal : '-' }}</td>
									<td data-label="Montant">{{ calendrier.argentRecolte|number_format(2, ',', ' ') }}
										€</td>
									<td data-label="Calendriers">{{ calendrier.nombreCalendrier }}</td>
									<td data-label="Date">{{ calendrier.createdAt|date('d/m/Y H:i') }}</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="7">Aucun historique.</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			{% endfor %}
		</div>

	</div>

	<style>
* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
}

html {
	scroll-behavior: smooth;
}

body {
	background: #f3f6fb;
	font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
	color: #0b2240;
}

.admin-page {
	width: 100%;
	max-width: 1250px;
	margin: 40px auto;
	padding: 20px;
}

.admin-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 25px;
}

.admin-page h1 {
	font-size: 32px;
}

.btn-create-user {
	background: #0b2240;
	color: white;
	text-decoration: none;
	padding: 12px 18px;
	border-radius: 10px;
	font-weight: 700;
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 8px;
	transition: 0.2s;
}

.btn-create-user:hover,
.btn-action:hover {
	background: #14355e;
}

.stats {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 20px;
	margin-bottom: 30px;
}

.card,
.section,
.user-card {
	background: #ffffff;
	border-radius: 18px;
	padding: 24px;
	box-shadow: 0 8px 25px rgba(11, 34, 64, 0.08);
	border: 1px solid #e5eaf1;
}

.card span {
	color: #64748b;
	font-size: 15px;
	font-weight: 700;
}

.card strong {
	display: block;
	margin-top: 12px;
	font-size: 38px;
	color: #0b2240;
}

.section {
	margin-bottom: 30px;
}

.section h2 {
	font-size: 22px;
	margin-bottom: 18px;
}

.admin-actions {
	display: flex;
	flex-direction: column;
	gap: 15px;
}

.create-city-form {
	display: grid;
	grid-template-columns: 1fr 1fr auto;
	gap: 12px;
}

.create-city-form input {
	height: 46px;
	padding: 0 14px;
	border: 1px solid #dbe3ee;
	border-radius: 10px;
	font-size: 14px;
	outline: none;
}

.create-city-form input:focus {
	border-color: #0b2240;
}

.btn-action,
.btn-danger {
	height: 46px;
	border: none;
	border-radius: 10px;
	padding: 0 18px;
	font-weight: 700;
	cursor: pointer;
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 8px;
}

.btn-action {
	background: #0b2240;
	color: white;
}

.btn-danger {
	background: #dc2626;
	color: white;
}

.btn-danger:hover {
	background: #b91c1c;
}

.profiles-grid {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
	gap: 15px;
}

.profile-card-wrapper {
	display: flex;
	gap: 8px;
}

.profile-card {
	background: #eef3f9;
	border: 1px solid #dbe3ee;
	border-radius: 14px;
	padding: 18px;
	text-decoration: none;
	color: #0b2240;
	font-weight: 700;
	display: flex;
	align-items: center;
	gap: 10px;
	transition: 0.2s;
	flex: 1;
	min-width: 0;
}

.profile-card span {
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.profile-card:hover {
	background: #dce8f5;
	transform: translateY(-2px);
}

.btn-delete-profile {
	min-width: 50px;
	border: none;
	border-radius: 14px;
	background: #fee2e2;
	color: #dc2626;
	cursor: pointer;
	font-size: 15px;
}

.btn-delete-profile:hover {
	background: #fecaca;
}

.user-card {
	margin-top: 20px;
	scroll-margin-top: 20px;
}

.user-card h3 {
	font-size: 17px;
	margin-bottom: 12px;
	color: #14355e;
	word-break: break-word;
}

table {
	width: 100%;
	border-collapse: collapse;
	margin-top: 12px;
	background: #ffffff;
	border-radius: 12px;
	overflow: hidden;
}

th {
	background: #eef3f9;
	color: #0b2240;
	padding: 14px;
	text-align: left;
	font-size: 14px;
	font-weight: 800;
	border-bottom: 1px solid #dbe3ee;
}

td {
	padding: 14px;
	border-bottom: 1px solid #edf2f7;
	font-size: 14px;
	color: #334155;
}

tr:hover td {
	background: #f8fafd;
}

tbody tr:last-child td {
	border-bottom: none;
}

/* TABLETTE */
@media(max-width: 900px) {
	.admin-page {
		margin: 25px auto;
		padding: 15px;
	}

	.stats {
		grid-template-columns: 1fr;
	}

	.admin-page h1 {
		font-size: 27px;
	}

	.create-city-form {
		grid-template-columns: 1fr;
	}

	.card,
	.section,
	.user-card {
		padding: 18px;
	}

	.card strong {
		font-size: 32px;
	}
}

/* MOBILE */
@media(max-width: 600px) {
	.admin-page {
		margin: 0;
		padding: 12px;
	}

	.admin-header {
		background: #ffffff;
		border-radius: 18px;
		padding: 18px;
		box-shadow: 0 8px 25px rgba(11, 34, 64, 0.08);
		border: 1px solid #e5eaf1;
		flex-direction: column;
		gap: 14px;
		text-align: center;
	}

	.admin-page h1 {
		font-size: 24px;
	}

	.btn-create-user {
		width: 100%;
		height: 48px;
	}

	.stats {
		gap: 12px;
		margin-bottom: 16px;
	}

	.card,
	.section,
	.user-card {
		border-radius: 16px;
		padding: 16px;
	}

	.card strong {
		font-size: 28px;
	}

	.section {
		margin-bottom: 16px;
	}

	.section h2 {
		font-size: 19px;
	}

	.profiles-grid {
		grid-template-columns: 1fr;
		gap: 10px;
	}

	.profile-card {
		min-height: 52px;
		padding: 14px;
	}

	.btn-delete-profile {
		width: 52px;
		min-width: 52px;
	}

	table,
	thead,
	tbody,
	th,
	td,
	tr {
		display: block;
		width: 100%;
	}

	table {
		margin-top: 10px;
	}

	thead {
		display: none;
	}

	tbody tr {
		background: #ffffff;
		border: 1px solid #e5eaf1;
		border-radius: 16px;
		padding: 12px;
		margin-bottom: 12px;
		box-shadow: 0 5px 14px rgba(11, 34, 64, 0.06);
	}

	td {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 14px;
		border-bottom: 1px solid #edf2f7;
		padding: 10px 0;
		font-size: 14px;
		text-align: right;
		word-break: break-word;
	}

	td:last-child {
		border-bottom: none;
	}

	td::before {
		content: attr(data-label);
		font-weight: 800;
		color: #0b2240;
		text-align: left;
		flex: 0 0 45%;
	}

	tr:hover td {
		background: transparent;
	}
}
</style>
{% endblock %}
