{% extends 'base.html.twig' %}

{% block title %}Admin - Amicale{% endblock %}

{% block body %}
<div class="admin-page">

	<div class="admin-header">
		<h1>Tableau de bord</h1>

		<a href="{{ path('app_register') }}" class="btn-create-user">
			<i class="fa-solid fa-user-plus"></i>
			Créer un compte
		</a>
	</div>

	<div class="stats">
		<div class="card">
			<span>Calendriers vendus</span>
			<strong>{{ totalCalendriers|default(0) }}</strong>
		</div>

		<div class="card">
			<span>Argent récolté</span>
			<strong>{{ totalArgent|default(0)|number_format(2, ',', ' ') }} €</strong>
		</div>

		<div class="card">
			<span>Profils créés</span>
			<strong>{{ users|length }}</strong>
		</div>
	</div>

	<div class="section">
		<h2>Profils</h2>

		<div class="profiles-grid">
			{% for user in users %}
				<a href="#user-{{ user.id }}" class="profile-card">
					<i class="fa-solid fa-user"></i>
					<span>{{ user.email }}</span>
				</a>
			{% else %}
				<p>Aucun utilisateur créé.</p>
			{% endfor %}
		</div>
	</div>

	<div class="section">
		<h2>Liste des tournées par ville</h2>

		<table>
			<thead>
				<tr>
					<th>Nom de la ville</th>
					<th>Code postal</th>
					<th>Argent récolté</th>
					<th>Calendriers vendus</th>
				</tr>
			</thead>
			<tbody>
				{% for tournee in tournees %}
					<tr>
						<td data-label="Ville">{{ tournee.ville }}</td>
						<td data-label="Code postal">{{ tournee.codePostal }}</td>
						<td data-label="Argent récolté">{{ tournee.totalArgent|default(0)|number_format(2, ',', ' ') }} €</td>
						<td data-label="Calendriers vendus">{{ tournee.totalCalendriers|default(0) }}</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="4">Aucune tournée enregistrée.</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>

	<div class="section">
		<h2>10 derniers calendriers donnés</h2>

		<table>
			<thead>
				<tr>
					<th>Nom</th>
					<th>Prénom</th>
					<th>Ville</th>
					<th>Code postal</th>
					<th>Montant</th>
					<th>Calendriers</th>
					<th>Ajouté par</th>
					<th>Date</th>
				</tr>
			</thead>
			<tbody>
				{% for calendrier in lastCalendriers %}
					<tr>
						<td data-label="Nom">{{ calendrier.nom }}</td>
						<td data-label="Prénom">{{ calendrier.prenom }}</td>
						<td data-label="Ville">{{ calendrier.tournee ? calendrier.tournee.ville : '-' }}</td>
						<td data-label="Code postal">{{ calendrier.tournee ? calendrier.tournee.codePostal : '-' }}</td>
						<td data-label="Montant">{{ calendrier.argentRecolte|number_format(2, ',', ' ') }} €</td>
						<td data-label="Calendriers">{{ calendrier.nombreCalendrier }}</td>
						<td data-label="Ajouté par">{{ calendrier.createdBy.email }}</td>
						<td data-label="Date">{{ calendrier.createdAt|date('d/m/Y H:i') }}</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="8">Aucun calendrier enregistré.</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>

	<div class="section">
		<h2>Historique par profil</h2>

		{% for user in users %}
			<div class="user-card" id="user-{{ user.id }}">
				<h3>{{ user.email }}</h3>

				<table>
					<thead>
						<tr>
							<th>Nom</th>
							<th>Prénom</th>
							<th>Ville</th>
							<th>Code postal</th>
							<th>Montant</th>
							<th>Calendriers</th>
							<th>Date</th>
						</tr>
					</thead>
					<tbody>
						{% for calendrier in user.calendriers %}
							<tr>
								<td data-label="Nom">{{ calendrier.nom }}</td>
								<td data-label="Prénom">{{ calendrier.prenom }}</td>
								<td data-label="Ville">{{ calendrier.tournee ? calendrier.tournee.ville : '-' }}</td>
								<td data-label="Code postal">{{ calendrier.tournee ? calendrier.tournee.codePostal : '-' }}</td>
								<td data-label="Montant">{{ calendrier.argentRecolte|number_format(2, ',', ' ') }} €</td>
								<td data-label="Calendriers">{{ calendrier.nombreCalendrier }}</td>
								<td data-label="Date">{{ calendrier.createdAt|date('d/m/Y H:i') }}</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="7">Aucun historique.</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% endfor %}
	</div>

</div>

<style>
* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
}

body {
	background: #f3f6fb;
	font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
	color: #0b2240;
}

.admin-page {
	width: 100%;
	max-width: 1250px;
	margin: 40px auto;
	padding: 20px;
}

.admin-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 25px;
}

.admin-page h1 {
	font-size: 32px;
}

.btn-create-user {
	background: #0b2240;
	color: white;
	text-decoration: none;
	padding: 12px 18px;
	border-radius: 10px;
	font-weight: 600;
	transition: 0.2s;
	display: flex;
	align-items: center;
	gap: 8px;
}

.btn-create-user:hover {
	background: #14355e;
}

.stats {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 20px;
	margin-bottom: 30px;
}

.card,
.section,
.user-card {
	background: #ffffff;
	border-radius: 18px;
	padding: 24px;
	box-shadow: 0 8px 25px rgba(11, 34, 64, 0.08);
	border: 1px solid #e5eaf1;
}

.card span {
	color: #64748b;
	font-size: 15px;
	font-weight: 600;
}

.card strong {
	display: block;
	margin-top: 12px;
	font-size: 38px;
	color: #0b2240;
}

.section {
	margin-bottom: 30px;
}

.section h2 {
	font-size: 22px;
	margin-bottom: 18px;
}

.profiles-grid {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
	gap: 15px;
}

.profile-card {
	background: #eef3f9;
	border: 1px solid #dbe3ee;
	border-radius: 14px;
	padding: 18px;
	text-decoration: none;
	color: #0b2240;
	font-weight: 700;
	display: flex;
	align-items: center;
	gap: 10px;
	transition: 0.2s;
}

.profile-card:hover {
	background: #dce8f5;
	transform: translateY(-2px);
}

.user-card {
	margin-top: 20px;
	scroll-margin-top: 20px;
}

.user-card h3 {
	font-size: 17px;
	margin-bottom: 12px;
	color: #14355e;
}

table {
	width: 100%;
	border-collapse: collapse;
	margin-top: 12px;
	background: #ffffff;
	border-radius: 12px;
	overflow: hidden;
}

th {
	background: #eef3f9;
	color: #0b2240;
	padding: 14px;
	text-align: left;
	font-size: 14px;
	font-weight: 700;
	border-bottom: 1px solid #dbe3ee;
}

td {
	padding: 14px;
	border-bottom: 1px solid #edf2f7;
	font-size: 14px;
	color: #334155;
}

tr:hover td {
	background: #f8fafd;
}

tbody tr:last-child td {
	border-bottom: none;
}

@media(max-width: 900px) {
	.admin-page {
		margin: 25px auto;
		padding: 15px;
	}

	.stats {
		grid-template-columns: 1fr;
	}

	.admin-page h1 {
		font-size: 27px;
	}

	.card,
	.section,
	.user-card {
		padding: 18px;
	}

	.card strong {
		font-size: 32px;
	}
}

@media(max-width: 600px) {
	.admin-header {
		flex-direction: column;
		gap: 15px;
	}

	.btn-create-user {
		width: 100%;
		justify-content: center;
	}

	.admin-page {
		margin: 15px auto;
		padding: 10px;
	}

	.admin-page h1 {
		font-size: 24px;
		text-align: center;
	}

	.card,
	.section,
	.user-card {
		border-radius: 14px;
		padding: 16px;
	}

	.card strong {
		font-size: 28px;
	}

	table,
	thead,
	tbody,
	th,
	td,
	tr {
		display: block;
		width: 100%;
	}

	thead {
		display: none;
	}

	tbody tr {
		background: #ffffff;
		border: 1px solid #e5eaf1;
		border-radius: 14px;
		padding: 12px;
		margin-bottom: 14px;
		box-shadow: 0 5px 14px rgba(11, 34, 64, 0.06);
	}

	td {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 15px;
		border-bottom: 1px solid #edf2f7;
		padding: 10px 0;
		font-size: 14px;
	}

	td:last-child {
		border-bottom: none;
	}

	td::before {
		content: attr(data-label);
		font-weight: 700;
		color: #0b2240;
		flex-shrink: 0;
	}

	tr:hover td {
		background: transparent;
	}
}
</style>
{% endblock %}